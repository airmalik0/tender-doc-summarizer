# ─────────────────────────────────────────────────────────────────────────────
# Конфигурация тендерного суммаризатора.
# Скопируйте файл в .env и при необходимости подставьте свои значения.
#
#   cp .env.example .env
#
# ВАЖНО: сервис работает и без единого ключа — в этом случае он использует
# offline-провайдер (детерминированный извлекатель на правилах). Ключ нужен,
# чтобы включить полноценное LLM-извлечение.
# ─────────────────────────────────────────────────────────────────────────────

# auto | anthropic | openai | gemini | offline
# auto — взять первого провайдера, для которого задан ключ; если ключей нет,
#        молча перейти в offline и написать об этом в warnings ответа.
LLM_PROVIDER=auto

# ── Anthropic (основной, рекомендуемый провайдер) ────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — глубина рассуждений и расход токенов
ANTHROPIC_EFFORT=medium

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Ограничения загрузки и разбора ───────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_PAGES=400

# ── OCR (нужен для сканов без текстового слоя) ───────────────────────────────
OCR_ENABLED=true
OCR_LANG=rus+eng
OCR_DPI=220
# Если на странице меньше символов, она считается сканом и уходит в OCR
OCR_MIN_CHARS_PER_PAGE=120

# ── Чанкинг длинных документов ───────────────────────────────────────────────
CHUNK_CHARS=14000
CHUNK_OVERLAP_CHARS=800
MAX_CHUNKS=12

# ── Кэш разборов (ключ — sha256 файла + провайдер + модель) ──────────────────
CACHE_ENABLED=true
CACHE_DIR=data/cache

# ── Прочее ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=2
